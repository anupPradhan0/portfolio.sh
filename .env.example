# Use a pooled PostgreSQL connection for Vercel; the server must support pgvector.
DB_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Google AI Studio API key from a project on the API Free tier.
GEMINI_API_KEY=
# Application-wide daily request cap, independent of Google's actual quotas.
RAG_DAILY_REQUEST_LIMIT=20
# Initial retrieval cutoff; tune using real questions after indexing.
RAG_MIN_SIMILARITY=0.60
