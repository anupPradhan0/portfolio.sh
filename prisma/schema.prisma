generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Comment {
  id         Int      @id @default(autoincrement())
  postSlug   String
  authorName String
  body       String?
  stickerId  String?
  visitorId  String
  createdAt  DateTime @default(now())

  @@index([postSlug, id])
  @@index([visitorId, postSlug, createdAt])
}

model BlogView {
  id        Int      @id @default(autoincrement())
  postSlug  String
  visitorId String
  viewedAt  DateTime @default(now())

  @@index([postSlug])
  @@index([visitorId, postSlug, viewedAt])
}

model KnowledgeDocument {
  id              String           @id
  kind            String
  title           String
  sourceUrl       String
  contentHash     String
  indexingVersion String
  updatedAt       DateTime         @default(now()) @updatedAt
  chunks          KnowledgeChunk[]

  @@index([kind])
}

model KnowledgeChunk {
  id         Int                        @id @default(autoincrement())
  documentId String
  position   Int
  content    String
  embedding  Unsupported("vector(768)")
  document   KnowledgeDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, position])
}

model ChatRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
